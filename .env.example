# ═══════════════════════════════════════════════════════════════════════════════
# AI Finance & Compliance Copilot — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Application Security
# ─────────────────────────────────────────────────────────────────────────────

# Secret key used to sign HMAC-SHA256 session tokens.
# MUST be set in production. Generate with: openssl rand -hex 32
# If unset in production, the application will refuse to start.
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — AI / LLM
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key — enables live AI Copilot chat & smart categorization.
# Without this, the app falls back to the local deterministic grounded engine.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Database
# ─────────────────────────────────────────────────────────────────────────────

# External PostgreSQL connection string.
# If unset, the app uses the embedded PGlite instance (stored in ./data/postgres/).
# Recommended for production deployments.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Compliance Alert Hooks
# ─────────────────────────────────────────────────────────────────────────────

# Slack Incoming Webhook URL for compliance deadline alerts.
# Users can also configure this per-session via the UI (stored in localStorage).
# Format: https://hooks.slack.com/services/TXXXXXXX/BXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Runtime
# ─────────────────────────────────────────────────────────────────────────────

# Node environment. Set to 'production' on hosted deployments.
# The seed endpoint (/api/seed) is blocked when NODE_ENV=production.
# Allowed values: development | production | test
NODE_ENV=development
